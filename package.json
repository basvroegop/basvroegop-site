{
  "name": "basvroegop-site",
  "description": "Publicatiearchief van Bas Vroegop, gebouwd met Hugo",
  "private": true,
  "type": "module",
  "author": "Bas Vroegop <bas@vroeg.app>",
  "homepage": "https://basvroegop.nl",
  "scripts": {
    "build": "./build.sh",
    "import:publications": "node scripts/import-publications.mjs",
    "import:ad": "node scripts/import-ad.mjs",
    "discover:nu": "node scripts/discover-nu.mjs && node scripts/select-nu.mjs",
    "import:nu": "node scripts/import-nu.mjs",
    "import:nrc": "node scripts/import-nrc.mjs",
    "import:bright": "node scripts/import-bright.mjs",
    "import:remaining-media": "node scripts/import-remaining-media.mjs",
    "import:weekly": "node scripts/import-weekly.mjs",
    "check": "prettier scripts --check",
    "format": "prettier scripts --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "sharp": "^0.35.4",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}
